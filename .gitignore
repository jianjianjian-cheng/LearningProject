# === Unity 生成文件夹 ===
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Unity 崩溃时生成的文件
sysinfo.txt

# MemoryCaptures / Recordings 体积很大
/[Mm]emoryCaptures/
/[Rr]ecordings/

# === Unity 缓存文件 ===
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.mdb
*.opendb
*.VC.db
*.unityproj
*.tmp

# Unity 生成的 meta 文件（对应上面的缓存文件）
*.pidb.meta
*.pdb.meta
*.mdb.meta

# === 构建产物 ===
*.apk
*.aab
*.app
*.unitypackage

# === IDE 缓存 ===
.vs/
.gradle/

# === Codely CLI ===
.codely-cli/
.codely.packages/
.codelyignore
.com-unity-codely.json
mem-log/
screenshots/

# === 系统文件 ===
.DS_Store
Thumbs.db